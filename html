<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sandra Refeições</title>

<script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-orange-50 p-4">

<div class="max-w-6xl mx-auto">

<div class="bg-orange-600 text-white p-8 rounded-3xl text-center shadow-xl">

<h1 class="text-5xl font-black">
Sandra Refeições 🍛
</h1>

<p class="mt-2">
Produção diária de almoço
</p>

</div>

<div class="grid lg:grid-cols-2 gap-8 mt-8">

<!-- CARDÁPIO -->

<div class="bg-white rounded-3xl shadow-xl p-6">

<h2 class="text-3xl font-bold text-orange-600 mb-6">
Escolha seu almoço
</h2>

<select
id="tipoAlmoco"
onchange="calcularTotal()"
class="w-full border-2 border-orange-200 rounded-2xl p-4 mb-6"
>

<option value="15">
Almoço R$ 15
</option>

<option value="18">
Almoço R$ 18
</option>

</select>

<h3 class="text-2xl font-bold text-orange-600 mb-4">
🍖 Carnes
</h3>

<div class="grid sm:grid-cols-2 gap-4 mb-8">

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Frango na Chapa">
Frango na Chapa
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Galinha Guisada">
Galinha Guisada
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Bife ao Molho">
Bife ao Molho
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Filé de Peixe">
Filé de Peixe
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Fígado Acebolado">
Fígado Acebolado
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="carne mr-2" value="Bisteca com Barbecue">
Bisteca com Barbecue
</label>

</div>

<h3 class="text-2xl font-bold text-orange-600 mb-4">
🍛 Complementos
</h3>

<div class="grid sm:grid-cols-2 gap-4">

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Feijão Preto">
Feijão Preto
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Feijão Mulato">
Feijão Mulato
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Feijão Macassar">
Feijão Macassar
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Arroz">
Arroz
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Macarrão">
Macarrão
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Legumes">
Legumes
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Vinagrete">
Vinagrete
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Purê de Batata Inglesa">
Purê de Batata Inglesa
</label>

<label class="border-2 border-orange-200 rounded-2xl p-4">
<input type="checkbox" class="acom mr-2" value="Farofa">
Farofa
</label>

</div>

</div>

<!-- CLIENTE -->

<div class="bg-white rounded-3xl shadow-xl p-6">

<h2 class="text-3xl font-bold text-orange-600 mb-6">
Dados do Cliente
</h2>

<div class="space-y-4">

<input
id="nome"
type="text"
placeholder="Nome"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
>

<input
id="telefone"
type="text"
placeholder="Telefone"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
>

<select
id="tipoEntrega"
onchange="mostrarEndereco(); calcularTotal();"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
>

<option value="Entrega">
Entrega
</option>

<option value="Retirada">
Retirada
</option>

</select>

<div id="boxEndereco">

<textarea
id="endereco"
placeholder="Digite o endereço completo"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
></textarea>

</div>

<select
id="pagamento"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
>

<option>Pix</option>
<option>Dinheiro</option>
<option>Crédito</option>
<option>Débito</option>
<option>Fiado</option>

</select>

<select
id="talher"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
>

<option>Talher: Sim</option>
<option>Talher: Não</option>

</select>

<textarea
id="observacao"
placeholder="Observação"
class="w-full border-2 border-orange-200 rounded-2xl p-4"
></textarea>

<div class="bg-orange-50 border-2 border-orange-200 rounded-3xl p-5">

<p class="text-lg">
Taxa entrega:
<strong>R$ 2,00</strong>
</p>

<p class="text-lg">
Carne extra:
<strong>+R$ 3,00</strong>
</p>

<p class="text-3xl font-black text-orange-700 mt-4">

Total:
R$
<span id="total">
17.00
</span>

</p>

</div>

<div class="grid md:grid-cols-2 gap-4">

<button
onclick="enviarPedido()"
class="bg-green-500 hover:bg-green-600 text-white font-bold p-5 rounded-2xl"
>

Enviar WhatsApp

</button>

<button
onclick="window.print()"
class="bg-blue-500 hover:bg-blue-600 text-white font-bold p-5 rounded-2xl"
>

Imprimir Pedido

</button>

</div>

</div>

</div>

</div>

<script>

function mostrarEndereco(){

const tipo =
document.getElementById("tipoEntrega").value;

const box =
document.getElementById("boxEndereco");

if(tipo === "Retirada"){

box.style.display = "none";

}else{

box.style.display = "block";

}

}

function calcularTotal(){

let total =
Number(
document.getElementById("tipoAlmoco").value
);

if(
document.getElementById("tipoEntrega").value
=== "Entrega"
){

total += 2;

}

const carnes =
document.querySelectorAll(".carne:checked");

if(carnes.length > 1){

total +=
(carnes.length - 1) * 3;

}

document.getElementById("total").innerText =
total.toFixed(2);

}

document.querySelectorAll(".carne").forEach(item=>{

item.addEventListener("change", calcularTotal);

});

function enviarPedido(){

const nome =
document.getElementById("nome").value;

const telefone =
document.getElementById("telefone").value;

const endereco =
document.getElementById("endereco").value;

const entrega =
document.getElementById("tipoEntrega").value;

const pagamento =
document.getElementById("pagamento").value;

const talher =
document.getElementById("talher").value;

const observacao =
document.getElementById("observacao").value;

const total =
document.getElementById("total").innerText;

if(nome === "" || telefone === ""){

alert("Preencha nome e telefone");

return;

}

if(entrega === "Entrega" && endereco === ""){

alert("Digite o endereço");

return;

}

let carnes = "";

document.querySelectorAll(".carne:checked")
.forEach(item=>{

carnes += `- ${item.value}\n`;

});

let acompanhamentos = "";

document.querySelectorAll(".acom:checked")
.forEach(item=>{

acompanhamentos += `- ${item.value}\n`;

});

let mensagem =
`🍛 PEDIDO - SANDRA REFEIÇÕES\n\n`;

mensagem +=
`👤 Nome: ${nome}\n`;

mensagem +=
`📞 Telefone: ${telefone}\n`;

mensagem +=
`🚚 ${entrega}\n`;

if(entrega === "Entrega"){

mensagem +=
`📍 Endereço: ${endereco}\n`;

}

mensagem +=
`💳 Pagamento: ${pagamento}\n`;

mensagem +=
`🍴 ${talher}\n`;

mensagem +=
`\n🍖 CARNES:\n${carnes}`;

mensagem +=
`\n🍛 COMPLEMENTOS:\n${acompanhamentos}`;

if(observacao !== ""){

mensagem +=
`\n📝 OBS:\n${observacao}\n`;

}

mensagem +=
`\n💰 TOTAL: R$ ${total}`;

window.open(
`https://wa.me/5581985427194?text=${encodeURIComponent(mensagem)}`,
"_blank"
);

}

mostrarEndereco();
calcularTotal();

</script>

</body>
</html>
